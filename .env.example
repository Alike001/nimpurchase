# Server-only configuration. Never expose an RPC credential to the browser.
# For Nimiq Testnet, use TestAlbatross exactly (not "testnet").
DATABASE_URL=postgres://DATABASE_USER:DATABASE_PASSWORD@localhost:5432/nimpurchase
NIMIQ_RPC_URL=https://YOUR-NIMIQ-RPC-ENDPOINT
NIMIQ_NETWORK=TestAlbatross
# Use your computer's LAN IP here when opening checkout links in Nimiq Pay on a phone.
PUBLIC_APP_URL=http://localhost:5173
